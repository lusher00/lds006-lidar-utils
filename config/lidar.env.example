# /etc/default/lidar — environment for the lidar service.
# Every value is optional; these are the defaults.

# Serial port the scanner is on, and its rate. The LDS-006 is fixed at 115200.
LIDAR_PORT=/dev/ttyAMA0
LIDAR_BAUD=115200

# HTTP port the daemon serves on. 8080 is the hailo-tracker page on this Pi.
LIDAR_HTTP_PORT=8081

# Spin the motor up as soon as the port opens. Set to 0 to leave it stopped
# until something POSTs /control — useful on a bench where a spinning scanner
# is a nuisance.
LIDAR_AUTOSTART=1
